# ── Supabase ──────────────────────────────────────────────
# Painel: https://supabase.com → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Brevo (envio de e-mail — grátis, 300/dia) ────────────
# 1. Crie conta em brevo.com
# 2. Vá em Configurações → Chaves de API → Crie uma chave
# 3. Em Senders → Add a new sender → coloque seu Gmail
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxx
SENDER_EMAIL=oanalistafinancas@gmail.com

# ── Mercado Pago ──────────────────────────────────────────
# Painel: https://www.mercadopago.com.br/developers/panel
MERCADOPAGO_ACCESS_TOKEN=APP_USR-0000000000000000-000000-xxxx
MERCADOPAGO_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# ── URL do site ───────────────────────────────────────────
# Preencha após o deploy no Cloudflare Pages
# Exemplo: https://o-analista-financas.pages.dev
SITE_URL=https://o-analista-financas.pages.dev

# ── Cron (recuperação de carrinho abandonado) ─────────────────────────────
# Crie qualquer senha aleatória (ex: gere em passwordsgenerator.net)
# Coloque a mesma senha no cron-job.org como header x-cron-secret
CRON_SECRET=sua-senha-secreta-aqui
